{
  "name": "heartcraft",
  "version": "0.1.0",
  "description": "Install AI personality prompts from HeartCraftLab into your Claude Code skills.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "heartcraft": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "prompt",
    "persona",
    "heartcraft",
    "cli",
    "skills"
  ],
  "author": "mulsense",
  "license": "MIT",
  "homepage": "https://heartcraftlab.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mulsense/heartcraft.git"
  },
  "bugs": {
    "url": "https://github.com/mulsense/heartcraft/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
